# Vercel 프로젝트 설정 > Environment Variables 에 아래 값들을 등록하세요.

# Flask 세션 서명 키. 반드시 고정값으로 설정 — 없으면 서버리스 인스턴스마다
# 값이 달라져서 로그인이 랜덤하게 풀립니다. 아래처럼 생성해서 붙여넣으세요:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Turso(https://turso.tech)에서 발급받은 DB URL과 토큰.
# turso db show <db-name> --url
# turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 킥보드에 부착된 라즈베리파이의 로컬 접속 주소.
# 폰이 파이의 WiFi 핫스팟(또는 파이가 붙는 핫스팟)에 연결되어 있을 때만 열립니다.
PI_LIVE_URL=http://raspberrypi.local:5000/
