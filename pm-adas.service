# 설치 방법 (파이에서, SSH로 접속한 뒤):
#   sudo cp pm-adas.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pm-adas
#
# 상태 확인: sudo systemctl status pm-adas
# 로그 확인: journalctl -u pm-adas -f
#
# User / WorkingDirectory / ExecStart 경로는 이 파이의 실제 계정(yeonwoo) 기준으로 맞춰둠.

[Unit]
Description=PM ADAS - 실시간 감지 서버
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yeonwoo
WorkingDirectory=/home/yeonwoo/AdasPM
ExecStart=/usr/bin/python3 /home/yeonwoo/AdasPM/app.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
